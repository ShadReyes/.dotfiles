#!/usr/bin/env bash
set -euo pipefail

# Resolve the launcher symlink in Python so imports work from ~/.local/bin.
for runtime in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$runtime" >/dev/null 2>&1 && "$runtime" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$runtime" -B -c 'import pathlib, sys; sys.path.insert(0, str(pathlib.Path(sys.argv.pop(1)).resolve().parent)); from skillset_lib.cli import main; raise SystemExit(main())' "$0" "$@"
  fi
done
printf '%s\n' 'skillset: Python 3.11+ is required. Install a supported python3 runtime; no dependencies were downloaded.' >&2
exit 2
