#!/usr/bin/env bash
set -euo pipefail

profile="${1:-}"

if [ -z "$profile" ]; then
  echo "Usage: herdr-init <profile>" >&2
  echo "Available profiles: fluid" >&2
  exit 2
fi

case "$profile" in
  fluid)
    workspace_label="Orchestrator"
    workspace_cwd="$HOME"
    ;;
  *)
    echo "Unknown Herdr profile: $profile" >&2
    echo "Available profiles: fluid" >&2
    exit 2
    ;;
esac

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr is required but was not found on PATH" >&2
  exit 127
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to initialize Herdr profiles" >&2
  exit 127
fi

herdr_cmd() {
  env -u HERDR_ENV herdr --session "$profile" "$@"
}

workspace_list() {
  herdr_cmd workspace list 2>/dev/null
}

if ! workspace_list >/dev/null; then
  log_dir="$HOME/.config/herdr/sessions/$profile"
  mkdir -p "$log_dir"
  log_file="$log_dir/bootstrap.log"

  herdr_cmd server >>"$log_file" 2>&1 &

  ready=0
  for _ in $(seq 1 50); do
    if workspace_list >/dev/null; then
      ready=1
      break
    fi
    sleep 0.1
  done

  if [ "$ready" -ne 1 ]; then
    echo "Timed out starting Herdr session: $profile" >&2
    echo "See $log_file" >&2
    exit 1
  fi
fi

if ! workspace_list | jq -e --arg label "$workspace_label" \
  '.result.workspaces[]? | select(.label == $label)' >/dev/null; then
  herdr_cmd workspace create \
    --label "$workspace_label" \
    --cwd "$workspace_cwd" \
    --no-focus >/dev/null
fi

exec env -u HERDR_ENV herdr --session "$profile"
