{
    "name": "Ricekit",
    "type": "dark",
    "uiTheme": "vs-dark",
    "colors": {
        "foreground": "{{foreground}}",
        "descriptionForeground": "{{muted}}",
        "disabledForeground": "{{muted}}",
        "icon.foreground": "{{foreground}}",
        "textLink.foreground": "{{accent}}",
        "textLink.activeForeground": "{{accent}}",
        "widget.border": "{{border}}",
        "toolbar.hoverBackground": "{{blend(background, foreground, 10%)}}",
        "editor.background": "{{background}}",
        "editor.foreground": "{{foreground}}",
        "editorLineNumber.foreground": "{{muted}}",
        "editorLineNumber.activeForeground": "{{foreground}}",
        "editorCursor.foreground": "{{accent}}",
        "editor.lineHighlightBackground": "{{blend(background, foreground, 5%)}}",
        "editor.selectionBackground": "{{blend(background, accent, 32%)}}",
        "editor.inactiveSelectionBackground": "{{blend(background, foreground, 10%)}}",
        "editor.selectionHighlightBackground": "{{blend(background, accent, 14%)}}",
        "editor.wordHighlightBackground": "{{blend(background, accent, 12%)}}",
        "editorWhitespace.foreground": "{{blend(background, foreground, 14%)}}",
        "editorIndentGuide.background1": "{{border}}",
        "editorBracketMatch.background": "{{blend(background, accent, 22%)}}",
        "editorBracketMatch.border": "{{accent}}",
        "editorGutter.background": "{{background}}",
        "editorWidget.background": "{{surface}}",
        "editorHover.background": "{{surface}}",
        "editorHover.border": "{{border}}",
        "editorError.foreground": "{{error}}",
        "editorWarning.foreground": "{{warning}}",
        "editorInfo.foreground": "{{info}}",
        "editorHint.foreground": "{{cyan}}",
        "scrollbarSlider.background": "{{blend(background, foreground, 16%)}}",
        "scrollbarSlider.hoverBackground": "{{blend(background, foreground, 26%)}}",
        "scrollbarSlider.activeBackground": "{{blend(background, foreground, 34%)}}",
        "activityBar.background": "{{background}}",
        "activityBar.foreground": "{{foreground}}",
        "activityBar.inactiveForeground": "{{muted}}",
        "activityBar.border": "{{border}}",
        "sideBar.background": "{{surface}}",
        "sideBar.foreground": "{{foreground}}",
        "sideBar.border": "{{border}}",
        "sideBarTitle.foreground": "{{foreground}}",
        "sideBarTitle.inactiveForeground": "{{muted}}",
        "list.activeSelectionBackground": "{{blend(background, accent, 20%)}}",
        "list.activeSelectionForeground": "{{foreground}}",
        "list.inactiveSelectionBackground": "{{blend(background, foreground, 8%)}}",
        "list.inactiveSelectionForeground": "{{foreground}}",
        "list.hoverBackground": "{{blend(background, foreground, 6%)}}",
        "list.focusBackground": "{{blend(background, accent, 15%)}}",
        "list.highlightForeground": "{{accent}}",
        "panel.background": "{{background}}",
        "panel.border": "{{border}}",
        "panelTitle.activeForeground": "{{foreground}}",
        "statusBar.background": "{{surface}}",
        "statusBar.foreground": "{{foreground}}",
        "statusBar.noFolderBackground": "{{background}}",
        "statusBar.debuggingBackground": "{{error}}",
        "titleBar.activeBackground": "{{background}}",
        "titleBar.inactiveBackground": "{{background}}",
        "titleBar.activeForeground": "{{foreground}}",
        "titleBar.inactiveForeground": "{{muted}}",
        "badge.background": "{{accent}}",
        "badge.foreground": "{{background}}",
        "input.background": "{{surface}}",
        "input.foreground": "{{foreground}}",
        "input.border": "{{border}}",
        "inputOption.activeBorder": "{{accent}}",
        "dropdown.background": "{{surface}}",
        "dropdown.foreground": "{{foreground}}",
        "dropdown.border": "{{border}}",
        "menu.background": "{{surface}}",
        "menu.foreground": "{{foreground}}",
        "menu.border": "{{border}}",
        "tab.activeBackground": "{{surface}}",
        "tab.activeForeground": "{{foreground}}",
        "tab.inactiveForeground": "{{muted}}",
        "tab.activeBorderTop": "{{accent}}",
        "tab.unfocusedActiveForeground": "{{muted}}",
        "focusBorder": "{{accent}}",
        "progressBar.background": "{{accent}}",
        "errorForeground": "{{error}}",
        "notificationToast.border": "{{border}}",
        "gitDecoration.addedResourceForeground": "{{green}}",
        "gitDecoration.modifiedResourceForeground": "{{yellow}}",
        "gitDecoration.deletedResourceForeground": "{{red}}",
        "gitDecoration.untrackedResourceForeground": "{{muted}}",
        "gitDecoration.ignoredResourceForeground": "{{muted}}",
        "gitDecoration.conflictingResourceForeground": "{{magenta}}"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "{{muted}}", "fontStyle": "italic" } },
        { "scope": ["keyword", "keyword.operator", "storage", "storage.type", "storage.modifier", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["keyword.control", "keyword.conditional", "keyword.repeat"], "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["string", "string.quoted", "string.unquoted", "constant.character.escape"], "settings": { "foreground": "{{green}}" } },
        { "scope": ["string.regexp", "constant.character"], "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["constant.numeric", "constant.language", "constant", "support.constant"], "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "{{foreground}}" } },
        { "scope": ["variable.language"], "settings": { "foreground": "{{red}}" } },
        { "scope": ["entity.name.function", "entity.name.function.call", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "{{blue}}" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "meta.class entity.name.type", "storage.type"], "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["support.class", "support.type.any", "entity.name.namespace"], "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "{{red}}" } },
        { "scope": ["entity.name.tag.pseudo-element", "entity.name.tag.pseudo-class", "entity.other.attribute-name", "meta.tag entity.name.type"], "settings": { "foreground": "{{cyan}}" } },
        { "scope": ["entity.name.section", "entity.name.label", "markup.heading", "markup.heading entity.name.section"], "settings": { "foreground": "{{accent}}", "fontStyle": "bold" } },
        { "scope": ["markup.bold", "markup.strong"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic", "markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "{{green}}" } },
        { "scope": ["markup.deleted"], "settings": { "foreground": "{{red}}" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["markup.link"], "settings": { "foreground": "{{blue}}", "fontStyle": "underline" } },
        { "scope": ["markup.underline"], "settings": { "fontStyle": "underline" } },
        { "scope": ["string.link"], "settings": { "foreground": "{{cyan}}", "fontStyle": "underline" } },
        { "scope": ["constant.language.boolean"], "settings": { "foreground": "{{cyan}}" } },
        { "scope": ["support.function.builtin", "support.type", "support.variable", "support.other.variable"], "settings": { "foreground": "{{cyan}}" } },
        { "scope": ["meta.import", "meta.preprocessor", "meta.include"], "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["invalid.illegal"], "settings": { "foreground": "{{error}}" } },
        { "scope": ["invalid.deprecated"], "settings": { "foreground": "{{muted}}", "fontStyle": "strikethrough" } },
        { "scope": ["punctuation.definition.string.begin", "punctuation.definition.string.end", "punctuation.definition.string"], "settings": { "foreground": "{{green}}" } },
        { "scope": ["punctuation.separator.key-value", "punctuation.section"], "settings": { "foreground": "{{foreground}}" } },
        { "scope": ["support.function.method.instance", "meta.function-call", "entity.name.function.local"], "settings": { "foreground": "{{blue}}" } },
        { "scope": ["entity.name.type.instance", "variable.other.property", "meta.property.object"], "settings": { "foreground": "{{cyan}}" } },
        { "scope": ["storage.type.function", "storage.type.class", "storage.type.interface"], "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["meta.brace", "meta.bracket", "punctuation.section.group", "punctuation.section.array", "punctuation.section.dictionary"], "settings": { "foreground": "{{foreground}}" } },
        { "scope": ["entity.name.function.decorator", "meta.annotation"], "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["string.interpolated", "punctuation.section.embedded"], "settings": { "foreground": "{{foreground}}" } },
        { "scope": ["constant.other.color", "constant.other.color.rgb-value"], "settings": { "foreground": "{{green}}" } }
    ]
}
